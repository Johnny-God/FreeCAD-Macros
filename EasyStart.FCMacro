# -*- coding: utf-8 -*-
# SPDX-License-Identifier: MIT
"""EasyStart — document bootstrapper for FreeCAD.

Creates a new document with a Part > Body structure plus a Spreadsheet,
optionally opening straight into a sketch, and saves it under a persistent
path with an auto-created per-project folder.

Run it as a macro: it opens a small dialog that asks for a file name and
gives Save / Continue Without Saving / Cancel.
"""

# Metadata read by the FreeCAD Addon Manager and the macro browser.
# Every value must be a plain string on a single line (no code, no wrapping).
__Name__ = "EasyStart"
__Comment__ = "Start a new document already set up as a Part with an active Body and a Spreadsheet, named and saved from one dialog."
__Author__ = "Benjamin M. Wood (JohnnyGod)"
__Version__ = "2026.11.15"
__Date__ = "2026-11-15"
__License__ = "MIT"
__Web__ = "https://github.com/Johnny-God/FreeCAD-Macros"
__Wiki__ = "https://wiki.freecad.org/Macro_EasyStart"
__Icon__ = "EasyStart.svg"
__Help__ = "Run it and enter a file name; choose Save, Continue Without Saving, or Cancel."
__Status__ = "Stable"
__Requires__ = "FreeCAD >= 0.20"
__Communication__ = "https://github.com/Johnny-God/FreeCAD-Macros/issues"
__Files__ = ""

import os
import getpass

import FreeCAD
import FreeCADGui

# Qt bindings: FreeCAD 1.0 ships PySide2, 1.1+/Qt6 ships PySide6. Old builds
# only expose PySide. Import whichever is present.
try:
    from PySide6 import QtWidgets, QtCore, QtGui
except ImportError:
    try:
        from PySide2 import QtWidgets, QtCore, QtGui
    except ImportError:
        from PySide import QtWidgets, QtCore, QtGui


SAVE_PATH_PARAM = "User parameter:BaseApp/Preferences/SavePath"
DIALOG_PARAM = "User parameter:BaseApp/Preferences/SaveDialog"


def _prefs(group):
    return FreeCAD.ParamGet(group)


def default_save_path():
    """Desktop if it exists, otherwise the home directory. Cross-platform."""
    home = os.path.expanduser("~")
    desktop = os.path.join(home, "Desktop")
    return desktop if os.path.isdir(desktop) else home


def sanitize_filename(name):
    """Drop path separators and characters illegal on Windows/macOS."""
    illegal = '<>:"/\\|?*'
    cleaned = "".join(c for c in name if c not in illegal and ord(c) >= 32)
    return cleaned.strip().rstrip(". ")


class SaveDialog(QtWidgets.QDialog):
    def __init__(self, *args, **kwargs):
        super(SaveDialog, self).__init__(*args, **kwargs)
        self.setWindowFlags(self.windowFlags() & ~QtCore.Qt.WindowCloseButtonHint
                            & ~QtCore.Qt.WindowMinMaxButtonsHint)
        layout = QtWidgets.QVBoxLayout(self)
        layout.setSpacing(5)
        layout.setContentsMargins(10, 10, 10, 10)

        # Input field for document name
        self.input_text = QtWidgets.QLineEdit(self)
        self.input_text.setPlaceholderText("Enter File Name")
        layout.addWidget(self.input_text)

        # Current save path label
        self.current_path = _prefs(SAVE_PATH_PARAM).GetString("path", default_save_path())
        self.path_display = QtWidgets.QLabel("Save Path: " + self.current_path, self)
        layout.addWidget(self.path_display)

        self.dialog_width = self._measure_width()
        self.setFixedWidth(self.dialog_width)

        # Checkboxes
        self.new_sketch_checkbox = QtWidgets.QCheckBox("Create Sketch", self)
        self.new_sketch_checkbox.setChecked(
            _prefs(DIALOG_PARAM).GetBool("create_new_sketch", False))
        layout.addWidget(self.new_sketch_checkbox)

        self.checkbox = QtWidgets.QCheckBox("Create Folder", self)
        self.checkbox.setChecked(
            _prefs(DIALOG_PARAM).GetBool("create_containing_folder", True))
        layout.addWidget(self.checkbox)

        # Buttons
        self.buttons = QtWidgets.QDialogButtonBox(QtCore.Qt.Horizontal, self)
        self.save_button = self.buttons.addButton("Save", QtWidgets.QDialogButtonBox.AcceptRole)
        self.dont_save_button = self.buttons.addButton(
            "Continue Without Saving", QtWidgets.QDialogButtonBox.RejectRole)
        self.discard_button = self.buttons.addButton(
            "Cancel", QtWidgets.QDialogButtonBox.DestructiveRole)
        layout.addWidget(self.buttons, 0, QtCore.Qt.AlignCenter)

        # Update Save Path Button
        self.update_button = QtWidgets.QPushButton("Change Save Path")
        self.update_button.setFixedWidth(self.dialog_width - 40)
        layout.addWidget(self.update_button, 0, QtCore.Qt.AlignCenter)

        # Connect signals
        self.save_button.clicked.connect(self.save_document)
        self.dont_save_button.clicked.connect(self.continue_without_saving)
        self.discard_button.clicked.connect(self.discard_document)
        self.update_button.clicked.connect(self.change_save_path)

        self.adjustSize()

    def _measure_width(self):
        metrics = QtGui.QFontMetrics(self.path_display.font())
        text_width = metrics.horizontalAdvance(self.path_display.text())
        return max(text_width + 40, 400)

    def resizeEvent(self, event):
        super(SaveDialog, self).resizeEvent(event)
        self.update_button.setFixedWidth(self.width() - 40)

    def save_document(self):
        name = sanitize_filename(self.input_text.text())
        if self.input_text.text() and not name:
            QtWidgets.QMessageBox.warning(self, "Invalid Name",
                                          "Please enter a valid file name.")
            return
        self._save_document(name, self.checkbox.isChecked(),
                            self.new_sketch_checkbox.isChecked(), self)

    def continue_without_saving(self):
        self._continue_without_saving(self.checkbox.isChecked(),
                                      self.new_sketch_checkbox.isChecked(), self)

    def discard_document(self):
        if FreeCAD.ActiveDocument:
            FreeCAD.closeDocument(FreeCAD.ActiveDocument.Name)
        self.accept()

    def change_save_path(self):
        directory = QtWidgets.QFileDialog.getExistingDirectory(
            self, "Select Save Directory", self.current_path)
        if directory:
            new_path = os.path.join(directory, "")
            _prefs(SAVE_PATH_PARAM).SetString("path", new_path)
            self.current_path = new_path
            self.path_display.setText("Save Path: " + new_path)
            QtWidgets.QMessageBox.information(self, "Save Path Updated",
                                              "New save path: " + new_path)
            self.dialog_width = self._measure_width()
            self.setFixedWidth(self.dialog_width)
            self.adjustSize()

    @staticmethod
    def _save_document(file_name, create_folder, create_new_sketch, dialog):
        try:
            prefs = _prefs(DIALOG_PARAM)
            prefs.SetBool("create_containing_folder", create_folder)
            prefs.SetBool("create_new_sketch", create_new_sketch)

            if file_name:
                save_path = _prefs(SAVE_PATH_PARAM).GetString("path", default_save_path())
                if create_folder:
                    folder_path = os.path.join(save_path, file_name)
                    os.makedirs(folder_path, exist_ok=True)
                    file_path = os.path.join(folder_path, file_name + ".FCStd")
                else:
                    file_path = os.path.join(save_path, file_name + ".FCStd")

                FreeCAD.ActiveDocument.saveAs(file_path)

            _finish(create_new_sketch)
            dialog.accept()
        except Exception as e:
            QtWidgets.QMessageBox.critical(dialog, "Error", str(e))

    @staticmethod
    def _continue_without_saving(create_folder, create_new_sketch, dialog):
        try:
            prefs = _prefs(DIALOG_PARAM)
            prefs.SetBool("create_containing_folder", create_folder)
            prefs.SetBool("create_new_sketch", create_new_sketch)

            _finish(create_new_sketch)
            dialog.accept()
        except Exception as e:
            QtWidgets.QMessageBox.critical(dialog, "Error", str(e))


def _finish(create_new_sketch):
    """Leave the new document in a usable state: sketch or active body."""
    if create_new_sketch:
        FreeCADGui.runCommand('PartDesign_NewSketch', 0)
    else:
        FreeCADGui.runCommand('Std_Workbench', 0)
        make_body_active()


def make_body_active():
    """Make the Body object the active object in FreeCAD."""
    if not (FreeCAD.ActiveDocument and FreeCADGui.ActiveDocument):
        return
    for obj in FreeCAD.ActiveDocument.Objects:
        if obj.TypeId == 'PartDesign::Body':
            FreeCADGui.Selection.addSelection(obj)
            view = FreeCADGui.ActiveDocument.ActiveView
            if view:
                view.setActiveObject('pdbody', obj)
            return


def create_document():
    doc = FreeCAD.newDocument("Unnamed")

    part = doc.addObject('App::Part', 'Part')
    part.Label = 'Part'
    doc.Tip = part
    doc.recompute()

    body = doc.addObject('PartDesign::Body', 'Body')
    part.addObject(body)
    doc.recompute()

    sheet = doc.addObject('Spreadsheet::Sheet', 'Spreadsheet')
    part.addObject(sheet)
    doc.recompute()

    return doc


if __name__ == "__main__":
    create_document()
    SaveDialog().exec()
